<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-feature android:name="android.software.leanback" android:required="true"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <application android:label="AstroWeb TV" android:icon="@drawable/tv_icon" android:banner="@drawable/tv_banner" android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar">
    <activity android:name=".MainActivity" android:launchMode="singleTop" android:exported="true" android:screenOrientation="landscape">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
      <intent-filter><action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH"/><action android:name="android.intent.action.SEARCH"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
    </activity>
  </application>
</manifest>